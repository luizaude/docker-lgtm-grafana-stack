## Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

## Demo mode (INSECURE): enables anonymous access in Grafana
## Use local-only playground/testing.
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ROLE=Admin

## Host ports
GRAFANA_PORT=3000
LOKI_PORT=3100
MIMIR_PORT=9009
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
ALLOY_UI_PORT=12345
DEMO_APP_PORT=8080
DEMO_APP_GO_PORT=8081

## OTLP
## Many SDKs expect gRPC endpoint as host:port (no http://)
OTEL_EXPORTER_OTLP_GRPC_ENDPOINT=alloy:4317
